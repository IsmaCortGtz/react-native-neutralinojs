{
  "name": "@react-native-neutralinojs/new-app-screen",
  "version": "0.0.0",
  "description": "Standalone desktop-adapted welcome and template screens for React Native Neutralinojs apps",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "main": "./dist/index.jsx",
  "module": "./dist/index.jsx",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "default": "./dist/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "author": {
    "name": "Ismael Cortés Gutiérrez",
    "url": "https://github.com/IsmaCortGtz/react-native-neutralinojs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsmaCortGtz/react-native-neutralinojs.git",
    "directory": "packages/new-app-screen"
  },
  "keywords": [
    "react-native",
    "neutralinojs",
    "neu",
    "new-app-screen",
    "template",
    "welcome-screen",
    "desktop"
  ],
  "peerDependencies": {
    "@neutralinojs/lib": "*",
    "react": "*",
    "react-native": "*",
    "react-native-neutralinojs": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "echo 'No lint specified'"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
