{
  "name": "react-native-neutralinojs",
  "version": "1.0.2",
  "description": "React Native CLI integration for Neutralinojs",
  "keywords": [
    "browser",
    "chrome",
    "cross-platform",
    "desktop",
    "desktop-framework",
    "framework",
    "javascript",
    "lightweight",
    "neu",
    "neutralinojs",
    "react-native",
    "webview"
  ],
  "homepage": "https://ismacortgtz.is-a.dev/react-native-neutralinojs/",
  "license": "MIT",
  "author": {
    "name": "Ismael Cortés Gutiérrez",
    "url": "https://github.com/IsmaCortGtz/react-native-neutralinojs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsmaCortGtz/react-native-neutralinojs.git"
  },
  "files": [
    "react-native.config.cjs",
    "dist/",
    "exports/"
  ],
  "type": "commonjs",
  "main": "exports/index.cjs",
  "module": "exports/index.js",
  "exports": {
    ".": {
      "import": "./exports/index.js",
      "require": "./exports/index.cjs"
    }
  },
  "scripts": {
    "build:version": "node scripts/build-version.mjs",
    "build:ts": "tsc",
    "build:bundle": "rolldown -c",
    "build": "run-s build:version build:ts build:bundle",
    "prepublishOnly": "run-s build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project react-native-neutralinojs:unit",
    "test:e2e": "vitest run --project react-native-neutralinojs:e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@bunchtogether/vite-plugin-flow": "^1.0.2",
    "@neutralinojs/neu": "^11.7.2",
    "@vitejs/plugin-react": "^6.1.1",
    "chalk": "^6.0.0",
    "vite": "^8.3.0",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "npm-run-all": "^4.1.5",
    "rolldown": "^1.2.9",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@neutralinojs/lib": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native-web": "^0.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0"
}
