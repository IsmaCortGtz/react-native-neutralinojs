{
  "name": "rn-neutralinojs-monorepo",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://ismacortgtz.is-a.dev/react-native-neutralinojs/",
  "scripts": {
    "build": "pnpm -r run build",
    "pack:all": "pnpm run build && mkdir -p tarballs && pnpm -r --filter=\"!rn-neutralinojs-monorepo\" pack --out tarballs/%s-%v.tgz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "pnpm -r run test",
    "test:unit": "vitest run --project *unit",
    "test:e2e": "vitest run --project *e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "dayjs": "^1.11.23",
    "mermaid": "^11.17.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0"
}
