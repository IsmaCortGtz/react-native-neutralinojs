{
  "name": "rn-neutralinojs-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt run build",
    "pack:all": "yarn build && mkdir -p tarballs && yarn workspaces foreach -A --no-private pack --out ../../tarballs/%s-%v.tgz",
    "test": "yarn workspaces foreach -Apt run test",
    "lint": "yarn workspaces foreach -Apt run lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
